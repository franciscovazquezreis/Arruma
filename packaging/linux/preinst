#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Antes de atualizar o pacote: apaga o código compilado que o Python cria em /usr/lib/arruma
# quando o Arruma corre como administrador. O prerm já o faz, mas as versões até à 0.2.0 não
# tinham prerm, e numa atualização é o prerm da versão anterior que corre.
[ "$1" = "upgrade" ] || exit 0
find /usr/lib/arruma -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true
exit 0
